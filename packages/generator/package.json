{
  "name": "@budhash/zap-sh",
  "version": "1.1.0",
  "description": "JavaScript generator for zap-sh scripts — byte-for-byte parity with the bash `zap-sh init` oracle.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./types/index.d.ts",
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "bundle": "node scripts/bundle-templates.mjs",
    "prebuild": "node scripts/bundle-templates.mjs",
    "build": "node scripts/build.mjs",
    "build:web": "node scripts/bundle-templates.mjs && node scripts/build-web.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:diff": "npm run build && node --test test/differential.mjs"
  },
  "keywords": [
    "zap-sh",
    "bash",
    "generator",
    "scaffold",
    "template"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "budhash",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/budhash/zap-sh.git",
    "directory": "packages/generator"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
